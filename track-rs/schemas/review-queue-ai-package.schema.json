{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://device-fix.local/schemas/review-queue-ai-package.schema.json",
  "title": "Review Queue AI Package Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "generatedAt",
    "inputPath",
    "filter",
    "baseName",
    "safeToSend",
    "issueCount",
    "files",
    "contracts",
    "notes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "review-queue-ai-package-v1"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "inputPath": {
      "type": "string",
      "minLength": 1
    },
    "filter": {
      "type": "string",
      "enum": ["all", "metric", "diagnostic", "highRisk", "pending"]
    },
    "baseName": {
      "type": "string",
      "minLength": 1
    },
    "safeToSend": {
      "type": "boolean"
    },
    "issueCount": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewQueueJson",
        "reviewQueueReport",
        "aiPrompt",
        "packageManifest"
      ],
      "properties": {
        "reviewQueueJson": {
          "$ref": "#/$defs/PackageFileName"
        },
        "reviewQueueReport": {
          "$ref": "#/$defs/PackageFileName"
        },
        "aiPrompt": {
          "$ref": "#/$defs/PackageFileName"
        },
        "packageManifest": {
          "$ref": "#/$defs/PackageFileName"
        }
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "contains": {
        "const": "track-rs/schemas/review-queue-ai-package.schema.json"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "PackageFileName": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "[/\\\\]"
      }
    }
  }
}
