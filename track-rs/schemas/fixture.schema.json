{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://device-fix.local/schemas/track-fixture.schema.json",
  "title": "Track SDK Replay Fixture",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "ruleId", "ruleVersion", "source", "request", "expected"],
  "properties": {
    "schemaVersion": {
      "const": "track-sdk-replay-fixture-v1"
    },
    "ruleId": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$"
    },
    "ruleVersion": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "enum": ["web_algorithm", "rust_infrastructure", "android_replay", "real_session_slice"]
    },
    "request": {
      "type": "object"
    },
    "expected": {
      "type": "object",
      "required": [
        "trackPointCount",
        "gpxTrackPointCount",
        "segmentCount",
        "totalDistanceMeters",
        "movingTimeSeconds",
        "totalAscentMeters",
        "totalDescentMeters"
      ],
      "properties": {
        "trackPointCount": {
          "type": "integer",
          "minimum": 0
        },
        "gpxTrackPointCount": {
          "type": "integer",
          "minimum": 0
        },
        "segmentCount": {
          "type": "integer",
          "minimum": 0
        },
        "totalDistanceMeters": {
          "type": "number"
        },
        "totalDistanceMetersTolerance": {
          "type": "number",
          "minimum": 0
        },
        "movingTimeSeconds": {
          "type": "number"
        },
        "movingTimeSecondsTolerance": {
          "type": "number",
          "minimum": 0
        },
        "totalAscentMeters": {
          "type": "number"
        },
        "totalAscentMetersTolerance": {
          "type": "number",
          "minimum": 0
        },
        "totalDescentMeters": {
          "type": "number"
        },
        "totalDescentMetersTolerance": {
          "type": "number",
          "minimum": 0
        },
        "selectedElevationSource": {
          "type": "string",
          "enum": ["BAROMETER", "GNSS", "NONE"]
        },
        "acceptedSampleIds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "weakSampleIds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "rejectedSampleIds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "acceptedRawPointIds": {
          "type": "array",
          "deprecated": true,
          "description": "Legacy alias for acceptedSampleIds.",
          "items": {
            "type": "integer"
          }
        },
        "weakRawPointIds": {
          "type": "array",
          "deprecated": true,
          "description": "Legacy alias for weakSampleIds.",
          "items": {
            "type": "integer"
          }
        },
        "rejectedRawPointIds": {
          "type": "array",
          "deprecated": true,
          "description": "Legacy alias for rejectedSampleIds.",
          "items": {
            "type": "integer"
          }
        },
        "decisionReasons": {
          "type": "object",
          "description": "Optional expected decision reason map keyed by sampleId encoded as a JSON object property name.",
          "propertyNames": {
            "pattern": "^[0-9]+$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "decisionReasonCounts": {
          "type": "object",
          "description": "Optional expected decision reason histogram. Keys are decision reason strings, values are expected counts.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "trackPoints": {
          "type": "array",
          "description": "Optional expected cleaned track point coordinate checks. Omitted fields are not checked.",
          "items": {
            "type": "object",
            "properties": {
              "sourceSampleId": {
                "type": "integer"
              },
              "lat": {
                "type": "number"
              },
              "lng": {
                "type": "number"
              },
              "latTolerance": {
                "type": "number",
                "minimum": 0
              },
              "lngTolerance": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
