{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://device-fix.local/schemas/track-rs-verification-manifest.schema.json",
  "title": "Track Rust Verification Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rustToolchainFile",
    "requiredTools",
    "optionalAppleTools",
    "appleTargets",
    "bootstrapCommand",
    "alwaysRunGates",
    "rustToolchainGates",
    "optionalAppleXcframeworkGate",
    "completionCriteria"
  ],
  "properties": {
    "schemaVersion": {
      "const": "track-rs-verification-manifest-v1"
    },
    "rustToolchainFile": {
      "const": "rust-toolchain.toml"
    },
    "requiredTools": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "optionalAppleTools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "appleTargets": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bootstrapCommand": {
      "const": "./scripts/bootstrap-rust-toolchain.sh"
    },
    "alwaysRunGates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rustToolchainGates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "optionalAppleXcframeworkGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env", "command", "requires"],
      "properties": {
        "env": {
          "const": "VERIFY_APPLE_XCFRAMEWORK=1"
        },
        "command": {
          "const": "apple/build-track-core-xcframework.sh"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "completionCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
